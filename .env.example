# Copy to .env.local and fill in. See docs/configuration.md for details.

# --- Gemini (required): understands requests, searches, writes and grades skills
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main model. Default: gemini-pro-latest
GEMINI_MODEL=
# Comma-separated models to try when the main one is overloaded or slow.
# Default: gemini-3-flash-preview,gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=

# --- GitHub (recommended): code search for existing SKILL.md files
# Fine-grained token, "Public repositories (read-only)", no extra permissions
GITHUB_TOKEN=

# --- Claude (optional): runs "Try it" and "Test" on real Claude.
# Without it, both run in simulated mode with Gemini.
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model for graded tests. Default: claude-opus-5-5
CLAUDE_MODEL=

# --- Free playground limits
# Model for the "Try it" chat. Default: claude-haiku-5-5
PLAYGROUND_MODEL=
# Minutes per session. Default: 10
PLAYGROUND_MINUTES=
# Sessions per visitor per 24 hours. Default: 3
PLAYGROUND_SESSIONS_PER_DAY=
# Hidden message cap per session. Default: 30
PLAYGROUND_MAX_MESSAGES=

# --- Skills hub (optional): accounts, publishing, Explore, stars, forks, versions
# See docs/hub-setup.md. Both values are public by design (protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
