# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: defaults to gemini-pro-latest (always Google's newest Pro model)
GEMINI_MODEL=

# Recommended: enables GitHub code search for existing SKILL.md files.
# Fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=

# Optional: comma-separated models to try when the main one is overloaded
GEMINI_FALLBACK_MODELS=

# Optional: comma-separated models to try when the main one is overloaded
GEMINI_FALLBACK_MODELS=
